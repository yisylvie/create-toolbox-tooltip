{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "${mod_sources}",
    "issues": "${mod_issues_url}",
    "homepage": "${mod_url}"
  },
  "license": "${mod_license}",
  "icon": "assets/create-toolbox-tooltip/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.yisylvie.createtoolboxtooltip.createToolboxTooltip"
    ],
    "shulkerboxtooltip": [
      "com.yisylvie.createtoolboxtooltip.createToolboxTooltipPlugin"
    ]
  },
  "mixins": [
    "createtoolboxtooltip-fabric.mixins.json",
    "createtoolboxtooltip-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "*",
    "shulkerboxtooltip": "${shulkerboxtooltip_version}",
    "minecraft": "${minecraft_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
